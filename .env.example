# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PORTFOLIO CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Public canonical site URL. Replace with the exact deployed origin in Vercel.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EMAIL CONFIGURATION (Server-side only)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Email provider: 'brevo' or 'resend'
# Brevo is the current provider. Keep RESEND_API_KEY only if intentionally using
# the existing Resend fallback. Never add real credentials to this template.
ENQUIRY_EMAIL_PROVIDER=brevo

# ← Brevo Configuration (if using ENQUIRY_EMAIL_PROVIDER=brevo)
# Get this from: https://app.brevo.com/settings/smtp-api
BREVO_API_KEY=

# ← Resend Configuration (if using ENQUIRY_EMAIL_PROVIDER=resend)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=

# Email sender identity (required for both providers)
# This MUST be a verified sender email in your chosen provider.
# For Brevo: https://app.brevo.com/settings/senders
# For Resend: https://resend.com/emails
ENQUIRY_FROM_EMAIL=
ENQUIRY_FROM_NAME=Muhammad Ali Ahmad | Portfolio

# Email recipient for enquiries, applications, and notifications
# This is where admin notifications will be sent
ENQUIRY_TO_EMAIL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SECURITY & ANTI-SPAM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Signing secret for enquiry form (prevent tampering)
# Generate: openssl rand -hex 16
# Or: python3 -c "import secrets; print(secrets.token_hex(16))"
# Minimum 32 characters, random alphanumeric
ENQUIRY_SIGNING_SECRET=

# AES-256-GCM key used to encrypt enquiry records in Upstash Redis.
# Generate a base64-encoded 32-byte value with: openssl rand -base64 32
ENQUIRY_DATA_ENCRYPTION_KEY=

# Rate limiting via Upstash Redis (prevent spam/DDoS)
# Get from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash: server-side queue token and the two callback verification keys.
# Copy from the QStash console; signing keys are rotated, so configure both.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Protects the optional persisted-outbox recovery endpoint. Keep secret.
CRON_SECRET=

# Cloudflare Turnstile CAPTCHA (bot detection)
# Get from: https://dash.cloudflare.com/
# The secret key (below) must NEVER be exposed in frontend
TURNSTILE_SECRET_KEY=

# ← Turnstile site key is intentionally public; only use in browser code
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

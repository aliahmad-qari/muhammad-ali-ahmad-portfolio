# Public canonical site URL; set this to your actual production domain.
NEXT_PUBLIC_SITE_URL=https://muhammad-ali-ahmad-portfolio.vercel.app

# Server only: never prefix these with NEXT_PUBLIC_.
# Use brevo for your existing account. Resend remains supported if explicitly selected.
ENQUIRY_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Optional: used only when selecting resend instead.
RESEND_API_KEY=
ENQUIRY_FROM_NAME=Muhammad Ali Ahmad | Portfolio
# Must be a sender email verified in your Brevo account, not the visitor email.
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
# At least 32 random characters.
ENQUIRY_SIGNING_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=

# Turnstile site keys are intentionally public; the secret above is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Existing optional EmailJS contact integration (public browser identifiers).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
